#!/bin/bash
# This is the new shell script for my hack of c8 on node 26+ on windows, use GitBash to execute it
# https://git-scm.com/install/windows
# 
# It gets c8 running with out calling c8.js, like it used to work
#

# default to the global install
c8p=~/AppData/Roaming/npm/node_modules/c8/bin/c8.mjs

if [ -z "${C8_HOME+x}" ]; then
    # echo "C8_HOME is completely unset"
    cwd=`pwd`
    c8p=$cwd/ui-group/ui_group_deps.ts.adligo.org/node_modules/c8/bin/c8.js
else
    # echo "C8_HOME is set to $C8_HOME"
    c8p=$C8_HOME/bin/c8.js
fi

# echo "executing c8 in $c8p"
node $c8p "$@"